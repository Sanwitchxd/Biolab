# BioLab backend - plantilla SIN valores reales.
# Para generar tu .env automaticamente desde database/CREDENCIALES.txt:  npm run crear-env
# Nunca subas el archivo .env a un repositorio.

# --- Servidor ---
# 127.0.0.1 = solo este equipo. En Docker usa 0.0.0.0
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# false | true | numero de proxies (usalo solo si hay un proxy inverso delante)
TRUST_PROXY=false
# Origenes permitidos por CORS (separados por coma). En desarrollo el proxy de Vite hace que no se use.
CORS_ORIGIN=http://localhost:5173,http://localhost:8443

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=biolab
# Zona horaria de Mexico (sin horario de verano)
DB_TIMEZONE=-06:00
DB_POOL_LIMIT=10

# Una cuenta de MySQL por rol (ver database/PERMISOS.md)
DB_GERENTE_USER=gerente_biolab
DB_GERENTE_PASSWORD=
DB_RECEPCION_USER=recepcion_biolab
DB_RECEPCION_PASSWORD=
DB_QUIMICO_USER=quimico_biolab
DB_QUIMICO_PASSWORD=

# --- Sesion (JWT) ---
# Cadena larga y aleatoria (minimo 32 caracteres). Cambiarla cierra todas las sesiones.
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=8h

# --- Limite de intentos de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- WhatsApp ---
# manual  = (por defecto) los mensajes quedan en la cola de Recepción: un clic abre WhatsApp Web con el texto listo.
# cloudapi = envío automático por la API oficial de WhatsApp Business (Meta). Requiere internet SALIENTE, cuenta de
#            Meta Business, token y número verificado. Meta solo permite texto libre dentro de 24 h de que el paciente
#            escribió; fuera de esa ventana hay que usar plantillas aprobadas (ver README del backend).
WHATSAPP_PROVIDER=manual
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_PAIS=52
# WHATSAPP_INTERVALO_SEG=60
